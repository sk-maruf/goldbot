{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/mcp/get_trade_history.output.schema.json",
  "title": "get_trade_history output",
  "description": "Closed trades (MCP §4.0). Every output carries env, tier, as_of_utc and health (MCP §4.0). No C4 data ever; the login only hashed (MCP-040). Errors use the generic MCP-042 shape, which is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010)."
    },
    "env": {
      "$ref": "../common.schema.json#/$defs/env"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tier",
          "description": "PT3 for LIVE cent data, PT2 for DEMO; null for BACKTEST/REPLAY snapshots that have no live tier."
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "health": {
      "$ref": "../common.schema.json#/$defs/health_state",
      "description": "Aggregate health at as_of_utc, so stale or unhealthy data is never mistaken for live (MCP §4.0)."
    },
    "params": {
      "$ref": "../common.schema.json#/$defs/params_label",
      "description": "FIXTURE when fixture parameters are in effect (RISK-066)."
    },
    "privacy_mode": {
      "type": "boolean",
      "description": "Privacy mode (default on): amounts as % of equity or R instead of currency (MCP-040)."
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "open_utc": {
            "$ref": "../common.schema.json#/$defs/utc_timestamp"
          },
          "close_utc": {
            "$ref": "../common.schema.json#/$defs/utc_timestamp"
          },
          "side": {
            "$ref": "../common.schema.json#/$defs/side"
          },
          "volume": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "entry_price": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "exit_price": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "pnl": {
            "$ref": "../common.schema.json#/$defs/privacy_amount"
          },
          "result_r": {
            "$ref": "../common.schema.json#/$defs/decimal"
          },
          "strategy": {
            "$ref": "../common.schema.json#/$defs/strategy_name"
          },
          "strategy_version": {
            "$ref": "../common.schema.json#/$defs/semver"
          }
        },
        "required": [
          "open_utc",
          "close_utc",
          "side",
          "volume",
          "entry_price",
          "exit_price",
          "pnl",
          "result_r",
          "strategy",
          "strategy_version"
        ]
      },
      "maxItems": 500
    }
  },
  "required": [
    "schema_version",
    "env",
    "tier",
    "as_of_utc",
    "health",
    "privacy_mode",
    "trades"
  ]
}
