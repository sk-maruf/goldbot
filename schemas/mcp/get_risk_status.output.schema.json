{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/mcp/get_risk_status.output.schema.json",
  "title": "get_risk_status output",
  "description": "Each P-xx limit against current utilisation, active triggers and emergency lifecycles (MCP §4.0). Read-only; MCP never changes any limit (MCP-010). Every output carries env, tier, as_of_utc and health (MCP §4.0). No C4 data ever; the login only hashed (MCP-040). Errors use the generic MCP-042 shape, which is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010)."
    },
    "env": {
      "$ref": "../common.schema.json#/$defs/env"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tier",
          "description": "PT3 for LIVE cent data, PT2 for DEMO; null for BACKTEST/REPLAY snapshots that have no live tier."
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "health": {
      "$ref": "../common.schema.json#/$defs/health_state",
      "description": "Aggregate health at as_of_utc, so stale or unhealthy data is never mistaken for live (MCP §4.0)."
    },
    "params": {
      "$ref": "../common.schema.json#/$defs/params_label",
      "description": "FIXTURE when fixture parameters are in effect (RISK-066)."
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "param_id": {
            "type": "string",
            "pattern": "^P-(0[1-9]|[1-2][0-9]|3[0-7])$"
          },
          "status": {
            "type": "string",
            "enum": [
              "USER_DECISION_REQUIRED",
              "PROPOSED",
              "BROKER_VERIFICATION_REQUIRED"
            ]
          },
          "approved_by_user": {
            "type": "boolean",
            "description": "RISK-092 approval flag."
          },
          "value": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal",
                "description": "Limit value in effect; null if none."
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 64,
            "description": "Unit / basis from the TRADING_RISK_SPEC §2 register."
          },
          "utilisation": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal",
                "description": "Current utilisation in the same unit; null where not applicable."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "param_id",
          "status",
          "approved_by_user",
          "value",
          "unit",
          "utilisation"
        ]
      },
      "maxItems": 64
    },
    "active_triggers": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/trigger_id"
      }
    },
    "trading_state": {
      "$ref": "../common.schema.json#/$defs/trading_state"
    },
    "emergency_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/uuidv7"
          },
          "type": {
            "type": "string",
            "enum": [
              "CANCEL_PENDING",
              "EMERGENCY_LIQUIDATE"
            ]
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "AUTHORIZED",
              "SUBMITTED",
              "CONFIRMED",
              "PARTIAL",
              "FAILED_DEADLINE",
              "BLOCKED_MARKET_CLOSED",
              "RECONCILED"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "lifecycle_state"
        ]
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "env",
    "tier",
    "as_of_utc",
    "health",
    "limits",
    "active_triggers",
    "trading_state",
    "emergency_actions"
  ]
}
