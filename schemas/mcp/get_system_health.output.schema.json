{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/mcp/get_system_health.output.schema.json",
  "title": "get_system_health output",
  "description": "Per-component health (OBSERVABILITY_SPEC §3). Every output carries env, tier, as_of_utc and health (MCP §4.0). No C4 data ever; the login only hashed (MCP-040). Errors use the generic MCP-042 shape, which is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010)."
    },
    "env": {
      "$ref": "../common.schema.json#/$defs/env"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tier",
          "description": "Null: this output has no performance tier."
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "health": {
      "$ref": "../common.schema.json#/$defs/health_state",
      "description": "Aggregate health at as_of_utc, so stale or unhealthy data is never mistaken for live (MCP §4.0)."
    },
    "params": {
      "$ref": "../common.schema.json#/$defs/params_label",
      "description": "FIXTURE when fixture parameters are in effect (RISK-066)."
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "../health_status.schema.json#/$defs/component_health"
      },
      "minItems": 1
    },
    "last_reconciliation_utc": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "env",
    "tier",
    "as_of_utc",
    "health",
    "components",
    "last_reconciliation_utc"
  ]
}
