{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/mcp/get_open_positions.output.schema.json",
  "title": "get_open_positions output",
  "description": "Broker-confirmed and ledger positions side by side (MCP §4.0). Every output carries env, tier, as_of_utc and health (MCP §4.0). No C4 data ever; the login only hashed (MCP-040). Errors use the generic MCP-042 shape, which is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010)."
    },
    "env": {
      "$ref": "../common.schema.json#/$defs/env"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tier",
          "description": "PT3 for LIVE cent data, PT2 for DEMO; null for BACKTEST/REPLAY snapshots that have no live tier."
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "health": {
      "$ref": "../common.schema.json#/$defs/health_state",
      "description": "Aggregate health at as_of_utc, so stale or unhealthy data is never mistaken for live (MCP §4.0)."
    },
    "params": {
      "$ref": "../common.schema.json#/$defs/params_label",
      "description": "FIXTURE when fixture parameters are in effect (RISK-066)."
    },
    "broker_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "$ref": "../common.schema.json#/$defs/mt5_ticket"
          },
          "side": {
            "$ref": "../common.schema.json#/$defs/side"
          },
          "volume": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "open_price": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "sl": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal_nonneg"
              },
              {
                "type": "null"
              }
            ]
          },
          "sl_broker_confirmed": {
            "type": "boolean"
          },
          "tp": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal_nonneg"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownership": {
            "type": "string",
            "enum": [
              "ENGINE",
              "GUARDIAN",
              "FOREIGN"
            ]
          }
        },
        "required": [
          "ticket",
          "side",
          "volume",
          "open_price",
          "sl",
          "sl_broker_confirmed",
          "tp",
          "ownership"
        ],
        "allOf": [
          {
            "description": "A broker-confirmed SL has a value (UI-015, GRD-030).",
            "if": {
              "properties": {
                "sl_broker_confirmed": {
                  "const": true
                }
              },
              "required": [
                "sl_broker_confirmed"
              ]
            },
            "then": {
              "properties": {
                "sl": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "maxItems": 500
    },
    "ledger_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "$ref": "../common.schema.json#/$defs/mt5_ticket"
          },
          "side": {
            "$ref": "../common.schema.json#/$defs/side"
          },
          "volume": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "open_price": {
            "$ref": "../common.schema.json#/$defs/decimal_nonneg"
          },
          "sl": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal_nonneg"
              },
              {
                "type": "null"
              }
            ]
          },
          "sl_broker_confirmed": {
            "type": "boolean"
          },
          "tp": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/decimal_nonneg"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownership": {
            "type": "string",
            "enum": [
              "ENGINE",
              "GUARDIAN",
              "FOREIGN"
            ]
          }
        },
        "required": [
          "ticket",
          "side",
          "volume",
          "open_price",
          "sl",
          "sl_broker_confirmed",
          "tp",
          "ownership"
        ],
        "allOf": [
          {
            "description": "A broker-confirmed SL has a value (UI-015, GRD-030).",
            "if": {
              "properties": {
                "sl_broker_confirmed": {
                  "const": true
                }
              },
              "required": [
                "sl_broker_confirmed"
              ]
            },
            "then": {
              "properties": {
                "sl": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "maxItems": 500
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clean": {
          "type": "boolean"
        },
        "last_run_utc": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "unreconciled": {
          "type": "boolean",
          "description": "UNRECONCILED display state (SYSTEM_ARCHITECTURE §2)."
        }
      },
      "required": [
        "clean",
        "last_run_utc",
        "unreconciled"
      ]
    }
  },
  "required": [
    "schema_version",
    "env",
    "tier",
    "as_of_utc",
    "health",
    "broker_positions",
    "ledger_positions",
    "reconciliation"
  ]
}
