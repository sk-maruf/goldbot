{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/mcp/get_market_snapshot.output.schema.json",
  "title": "get_market_snapshot output",
  "description": "Market snapshot (MCP §4.0). Every output carries env, tier, as_of_utc and health (MCP §4.0). No C4 data ever; the login only hashed (MCP-040). Errors use the generic MCP-042 shape, which is outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010)."
    },
    "env": {
      "$ref": "../common.schema.json#/$defs/env"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/tier",
          "description": "PT3 for LIVE cent data, PT2 for DEMO; null for BACKTEST/REPLAY snapshots that have no live tier."
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc": {
      "$ref": "../common.schema.json#/$defs/utc_timestamp"
    },
    "health": {
      "$ref": "../common.schema.json#/$defs/health_state",
      "description": "Aggregate health at as_of_utc, so stale or unhealthy data is never mistaken for live (MCP §4.0)."
    },
    "params": {
      "$ref": "../common.schema.json#/$defs/params_label",
      "description": "FIXTURE when fixture parameters are in effect (RISK-066)."
    },
    "symbol": {
      "type": "string",
      "maxLength": 64,
      "description": "Symbol."
    },
    "bid": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/decimal_nonneg"
        },
        {
          "type": "null"
        }
      ]
    },
    "ask": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/decimal_nonneg"
        },
        {
          "type": "null"
        }
      ]
    },
    "spread": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/decimal_nonneg"
        },
        {
          "type": "null"
        }
      ]
    },
    "tick_age_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "description": "Tick age (TIME-020)."
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "type": "string",
      "enum": [
        "REAL_TIME",
        "DELAYED",
        "STALE",
        "CLOSED"
      ]
    },
    "session_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
      "description": "Session state. Values not fixed by the spec."
    },
    "next_blackout": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_utc": {
              "$ref": "../common.schema.json#/$defs/utc_timestamp"
            },
            "end_utc": {
              "$ref": "../common.schema.json#/$defs/utc_timestamp"
            }
          },
          "required": [
            "start_utc",
            "end_utc"
          ],
          "description": "Next P-18 news blackout window."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "env",
    "tier",
    "as_of_utc",
    "health",
    "symbol",
    "bid",
    "ask",
    "spread",
    "tick_age_ms",
    "freshness",
    "session_state",
    "next_blackout"
  ]
}
