{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/trading_state_event.schema.json",
  "title": "TradingStateEvent",
  "description": "A trigger, resumption or clear of the trading state (TRADING_RISK_SPEC §7; tables trading_state_events and failure_events). Every trigger, resumption and clear is audited. Only AUTO-class triggers resume automatically (RISK-052); RISK-053 lists those that never do.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010). Breaking changes need a migration and an ADR line."
    },
    "env": {
      "$ref": "common.schema.json#/$defs/env"
    },
    "params": {
      "$ref": "common.schema.json#/$defs/params_label",
      "description": "Present with value FIXTURE when fixture values of unapproved parameters are in effect (RISK-005, RISK-066 item 3, MI-045). Absent otherwise; the spec names no value for the approved case."
    },
    "fixture_demo_mode": {
      "$ref": "common.schema.json#/$defs/entry_authorization_mode",
      "description": "Fixture demo only: the entry authorization mode the user set for this run in fixture_demo_mode (RISK-066 item 4). Absent outside fixture demo."
    },
    "mono_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Engine monotonic sequence number for ordering within a process (DATA-003). Optional because records not written by the engine (research, Guardian ingest) have none."
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "kind": {
      "type": "string",
      "enum": [
        "TRIGGER",
        "RESUMPTION",
        "CLEAR"
      ],
      "description": "Transcribed from §7 'trigger, resumption and clear'."
    },
    "trigger": {
      "$ref": "common.schema.json#/$defs/trigger_id",
      "description": "Trigger T1..T27."
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "from_state": {
      "$ref": "common.schema.json#/$defs/trading_state"
    },
    "to_state": {
      "$ref": "common.schema.json#/$defs/trading_state"
    },
    "recovery_class": {
      "$ref": "common.schema.json#/$defs/recovery_class"
    },
    "cooldown_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "description": "P-34 cooldown for AUTO triggers, in ms. Null where the table shows '—' or 'next UTC day'."
        },
        {
          "type": "null"
        }
      ]
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string",
            "enum": [
              "HC-1",
              "HC-2",
              "HC-3",
              "HC-4",
              "HC-5",
              "HC-6",
              "HC-7",
              "HC-8",
              "HC-9",
              "HC-10"
            ]
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "check",
          "passed"
        ]
      },
      "description": "Health-check bundle results HC-1..HC-10."
    },
    "resumed_by": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "AUTO",
            "ACK",
            "MANUAL"
          ],
          "description": "How the state was resumed (failure_events.resumed_by). Null for TRIGGER."
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/actor"
    },
    "reason": {
      "type": "string",
      "maxLength": 512,
      "description": "Cause shown to the user."
    }
  },
  "required": [
    "schema_version",
    "env",
    "id",
    "ts",
    "kind",
    "trigger",
    "severity",
    "from_state",
    "to_state",
    "recovery_class",
    "cooldown_ms",
    "health_checks",
    "resumed_by",
    "actor",
    "reason"
  ]
}
