{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/risk_approved_action.schema.json",
  "title": "RiskApprovedAction",
  "description": "The only object execution accepts for risk-increasing operations (RISK-001). Constructed only by RiskEngine (private constructor in core/risk_engine.py); this schema describes its serialised form and grants no authority. SL is mandatory for risk-increasing actions (RISK-030).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version (DATA-010). Breaking changes need a migration and an ADR line."
    },
    "env": {
      "$ref": "common.schema.json#/$defs/env"
    },
    "params": {
      "$ref": "common.schema.json#/$defs/params_label",
      "description": "Present with value FIXTURE when fixture values of unapproved parameters are in effect (RISK-005, RISK-066 item 3, MI-045). Absent otherwise; the spec names no value for the approved case."
    },
    "fixture_demo_mode": {
      "$ref": "common.schema.json#/$defs/entry_authorization_mode",
      "description": "Fixture demo only: the entry authorization mode the user set for this run in fixture_demo_mode (RISK-066 item 4). Absent outside fixture demo."
    },
    "mono_seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Engine monotonic sequence number for ordering within a process (DATA-003). Optional because records not written by the engine (research, Guardian ingest) have none."
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "risk_decision_id": {
      "$ref": "common.schema.json#/$defs/uuidv7"
    },
    "signal_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_hash": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256_hex",
          "description": "Proposal hash when the entry went through human approval (API-030, RISK-004). Null otherwise."
        },
        {
          "type": "null"
        }
      ]
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/utc_timestamp",
      "description": "Evaluation time; re-checked against P-29 at send time."
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "symbol": {
      "type": "string",
      "maxLength": 64,
      "description": "Symbol name."
    },
    "side": {
      "$ref": "common.schema.json#/$defs/side"
    },
    "ticket": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/mt5_ticket",
          "description": "Target position/order ticket for modifications and reductions; null for new entries."
        },
        {
          "type": "null"
        }
      ]
    },
    "volume": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/decimal_nonneg",
          "description": "Approved volume (RISK-013). Null for SL/TP modifications."
        },
        {
          "type": "null"
        }
      ]
    },
    "entry_price": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/decimal_nonneg",
          "description": "Executable-side price used in the evaluation (RISK-011)."
        },
        {
          "type": "null"
        }
      ]
    },
    "sl": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/decimal_nonneg"
        },
        {
          "type": "null"
        }
      ]
    },
    "tp": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/decimal_nonneg"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelled_loss": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/money"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "env",
    "id",
    "risk_decision_id",
    "signal_id",
    "proposal_hash",
    "ts",
    "action",
    "symbol",
    "side",
    "ticket",
    "volume",
    "entry_price",
    "sl",
    "tp",
    "modelled_loss"
  ],
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "OPEN_POSITION",
        "ADD_VOLUME",
        "PLACE_PENDING_ORDER",
        "MODIFY_TP",
        "TIGHTEN_SL",
        "CLOSE_POSITION",
        "PARTIAL_CLOSE",
        "CANCEL_PENDING_ORDER"
      ],
      "description": "Action type transcribed from the RISK-002 prose (risk-increasing: open position, add volume, place pending order; modification: TP change, SL tightening; reduction: close, partial close, cancel pending). Widening an SL is prohibited and has no value."
    }
  },
  "if": {
    "properties": {
      "action": {
        "enum": [
          "OPEN_POSITION",
          "ADD_VOLUME",
          "PLACE_PENDING_ORDER"
        ]
      }
    }
  },
  "then": {
    "properties": {
      "sl": {
        "type": "string"
      },
      "volume": {
        "type": "string"
      },
      "modelled_loss": {
        "$ref": "common.schema.json#/$defs/money"
      },
      "entry_price": {
        "type": "string"
      }
    },
    "description": "Risk-increasing approvals carry SL, volume, entry price and a modelled loss; a missing modelled loss means reject (RISK-011)."
  },
  "allOf": [
    {
      "description": "TIGHTEN_SL targets a ticket and carries the new SL (RISK-030..034).",
      "if": {
        "properties": {
          "action": {
            "const": "TIGHTEN_SL"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "sl": {
            "type": "string"
          },
          "ticket": {
            "$ref": "common.schema.json#/$defs/mt5_ticket"
          }
        }
      }
    },
    {
      "description": "MODIFY_TP targets a ticket and carries the new TP.",
      "if": {
        "properties": {
          "action": {
            "const": "MODIFY_TP"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "tp": {
            "type": "string"
          },
          "ticket": {
            "$ref": "common.schema.json#/$defs/mt5_ticket"
          }
        }
      }
    },
    {
      "description": "Closes and cancellations target a ticket (EXE-002 item 5).",
      "if": {
        "properties": {
          "action": {
            "enum": [
              "CLOSE_POSITION",
              "PARTIAL_CLOSE",
              "CANCEL_PENDING_ORDER"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "ticket": {
            "$ref": "common.schema.json#/$defs/mt5_ticket"
          }
        }
      }
    }
  ]
}
