{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldbot.local/schemas/common.schema.json",
  "title": "GoldBot common definitions",
  "description": "Shared $defs referenced by every GoldBot schema. Not a record schema itself: it validates nothing at its root. Money, prices and volumes are decimal strings, never JSON numbers (RISK-020..024, DATA-004).",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64,
      "description": "Signed decimal as a string, produced from Decimal (RISK-020/021). Never a JSON number, never exponent notation."
    },
    "decimal_nonneg": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 64,
      "description": "Non-negative decimal string. Used for prices, volumes, distances and percentages."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Currency code as reported by MT5 (e.g. USC, USD; RISK-023). Three upper-case letters; the full set is not fixed by the spec, so no enum."
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "description": "Money(amount, currency) per RISK-023 and DATA-004. Arithmetic across currencies is an error."
    },
    "env": {
      "type": "string",
      "enum": [
        "LIVE",
        "DEMO",
        "BACKTEST",
        "REPLAY"
      ],
      "description": "Environment (DATA-005)."
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "Timezone-aware UTC, ISO-8601 with milliseconds and a Z suffix (TIME-011, DATA-003)."
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "UUIDv7, lower-case canonical form (DATA-002)."
    },
    "health_state": {
      "type": "string",
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "UNHEALTHY",
        "FAILED",
        "UNKNOWN"
      ],
      "description": "Component health (OBSERVABILITY_SPEC §3). UNKNOWN is never shown as healthy (OBS-001)."
    },
    "trading_state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ENTRY_STOP",
        "SUSPENDED"
      ],
      "description": "Trading state (TRADING_RISK_SPEC §7)."
    },
    "entry_authorization_mode": {
      "type": "string",
      "enum": [
        "MANUAL_APPROVAL",
        "AUTO_ALL",
        "AUTO_APPROVED_STRATEGIES"
      ],
      "description": "Entry authorization mode (P-37, TRADING_RISK_SPEC §9). Pending user decision D-01; no value is a default."
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ],
      "description": "Trade direction."
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 digest, lower-case hex."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
      "description": "Upper-snake-case reason code. Used where the spec names codes but gives no closed list."
    },
    "trigger_id": {
      "type": "string",
      "pattern": "^T([1-9]|1[0-9]|2[0-7])$",
      "description": "Trading-state trigger T1..T27 (TRADING_RISK_SPEC §7)."
    },
    "recovery_class": {
      "type": "string",
      "enum": [
        "AUTO",
        "ACK",
        "MANUAL"
      ],
      "description": "Recovery class (TRADING_RISK_SPEC §7)."
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "description": "Trigger severity as used in the TRADING_RISK_SPEC §7 table."
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5",
        "M15",
        "M30",
        "H1",
        "H4",
        "D1"
      ],
      "description": "Supported timeframes (MI-016)."
    },
    "tier": {
      "type": "string",
      "enum": [
        "PT0",
        "PT1",
        "PT2",
        "PT3"
      ],
      "description": "Performance tier (BACKTESTING_SPEC §1). Never mixed in one number (BT-001)."
    },
    "params_label": {
      "type": "string",
      "const": "FIXTURE",
      "description": "Fixture-parameter label (RISK-066 item 3)."
    },
    "mt5_ticket": {
      "type": "integer",
      "minimum": 0,
      "description": "MT5 position, order or deal ticket (an unsigned integer identifier, not an amount)."
    },
    "mt5_retcode": {
      "type": "integer",
      "minimum": 0,
      "description": "MT5 trade server return code (EXECUTION_SAFETY_SPEC §4)."
    },
    "strategy_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "description": "Strategy name. The naming format is not fixed by the spec; this pattern is a conservative cap."
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Semantic version (RES-010/011)."
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
      "description": "Who acted (user, engine component, Guardian). The spec names no closed set of actors."
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,128}$",
      "description": "Deterministic hash of module@version, concept, symbol, timeframe and anchor times (MI-010). The hash function and length are not fixed by the spec."
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "OK",
            "DEGRADED",
            "INSUFFICIENT"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/reason_code"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "description": "Data quality with a reason (MI-010, MI-015)."
    },
    "privacy_amount": {
      "description": "MCP amount (MCP-040). With privacy mode on (the default) an amount is given as % of equity or in R, never in currency.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "money": {
              "$ref": "#/$defs/money"
            }
          },
          "required": [
            "money"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "percent_of_equity": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "percent_of_equity"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "r": {
              "$ref": "#/$defs/decimal"
            }
          },
          "required": [
            "r"
          ]
        }
      ]
    }
  }
}
